// NEXIA — Cloudflare Worker + Container (ADR-HOST-01). Deploy só pelo workflow manual
// "Deploy Cloudflare" ou por `npx wrangler deploy`, nunca automático.
// Segredos: `npx wrangler secret put NOME` (lista em .env.example). Nada de valor real aqui.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexia",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // ADR-F12-03: retomada de execuções paradas, de hora em hora (exige o segredo NEXIA_CRON_SECRET)
  "triggers": { "crons": ["7 * * * *"] },
  "containers": [
    {
      "class_name": "NexiaBackend",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXIA_BACKEND", "class_name": "NexiaBackend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NexiaBackend"] }]
}
