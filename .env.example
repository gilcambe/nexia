# NEXIA OS — variáveis de ambiente (exemplo). NUNCA coloque valores reais aqui.
# Tudo no plano GRÁTIS (ADR-FREE-01..03). Valores reais: segredos do REPOSITÓRIO no GitHub
# (Settings → Secrets and variables → Actions). O deploy copia para o Worker os nomes desta lista e
# o workflow "NEXIA Jobs" usa os mesmos. Nomes começando com GITHUB_ são cadastrados no GitHub com
# o prefixo NEXIA_ (ex.: NEXIA_GITHUB_APP_ID), porque o GitHub não aceita segredo GITHUB_*. Ver PILOT-RUNBOOK.md.

NODE_ENV=production
PORT=3001
NEXIA_APP_URL=
# Domínio do Worker para onde os domínios de tenant apontam o CNAME (ex.: app.seudominio.com)
NEXIA_CNAME_TARGET=
# Só para quem roda o server.js por conta própria: segredo da rota interna de retomada (32+ caracteres).
# No Worker não precisa: o Cron dele chama a retomada direto (ADR-FREE-02).
NEXIA_CRON_SECRET=
# Fila de tarefas longas no GitHub Actions (ADR-FREE-02). NEXIA_JOBS, _REPO e _REF já vêm no wrangler.jsonc.
# NEXIA_JOBS_TOKEN: token fine-grained do GitHub (grátis) só no repositório gilcambe/nexia, permissão
# "Actions: Read and write". Sem ele, pedidos longos ficam registrados mas não andam.
NEXIA_JOBS_TOKEN=
# Leitura de repositórios privados no onboarding (opcional; sem ele lê só repositórios públicos)
NEXIA_GITHUB_TOKEN=

# Firebase (servidor): chave de serviço; o NEXIA fala com o Firestore e o Auth pela API REST (plano Spark, grátis)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Firebase Web (cliente, servido em /api/firebase-config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Master por e-mail: opcional, sem valor padrão; só vale com e-mail verificado
MASTER_EMAIL=

# Provedores de IA (ADR-FREE-03). GRÁTIS: GEMINI_API_KEY (aistudio.google.com), GROQ_API_KEY
# (console.groq.com), OPENROUTER_API_KEY (modelos ":free"), MISTRAL_API_KEY (console.mistral.ai, plano Experiment),
# CLOUDFLARE_AI_TOKEN + CLOUDFLARE_AI_ACCOUNT_ID (Workers AI, cota diária grátis). O GitHub Models não precisa de
# chave: usa o token do próprio GitHub Actions (ADR-FREE-04). CEREBRAS_API_KEY passou a ser paga (out/2026).
# PAGO por uso: ANTHROPIC_API_KEY, OPENAI_API_KEY, DEEPSEEK_API_KEY. Deixe vazias para não pagar nada.
# Trocar a lista de modelos dos agentes: NEXIA_MODELS_CODING / _REASONING / _FAST ("provedor:modelo,...").
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_ACCOUNT_ID=
NEXIA_MODELS_CODING=
NEXIA_MODELS_REASONING=
NEXIA_MODELS_FAST=

# Fotos e vídeos dos sites que o Cortex cria (ADR-Q-03). Sem chave já funciona (Openverse e Wikimedia
# Commons). PEXELS_API_KEY é GRÁTIS (pexels.com/api) e traz fotos e vídeos de melhor qualidade.
PEXELS_API_KEY=

# Segredos de endpoints internos (mínimo 32 caracteres aleatórios)
METRICS_SECRET=
DUNNING_SECRET=

# Integrações
GITHUB_TOKEN=
GITHUB_REPO=
# GitHub App do NEXIA (Fase 8): obrigatória para escrever no GitHub (branch, commit, PR).
# Chave privada em PEM (pode ser uma linha com \n). Nunca commitar o valor.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Integrações por cliente (Fase 9): o Vault guarda só o NOME da variável, que tem que ser
# NEXIA_<FIREBASE|CLOUDFLARE>_<TENANT>_<SUFIXO> (TENANT = slug em maiúsculas, "-" vira "_").
# Ex.: NEXIA_FIREBASE_CLIENTE_ALFA_SA (JSON de service account só leitura),
#      NEXIA_CLOUDFLARE_CLIENTE_ALFA_TOKEN (API token só leitura).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Feature flags de segurança (Fase 1) — desligadas por padrão
# AUTOCOMMIT_ENABLED removido na Fase 8 (autocommit legado substituído pelo GitHub Adapter)
SENTINEL_HEAL_ENABLED=false
