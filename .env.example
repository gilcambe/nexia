# NEXIA OS — variáveis de ambiente (exemplo). NUNCA coloque valores reais aqui.
# Valores reais ficam no painel do Render (ou outro secret store).

NODE_ENV=production
PORT=3001
NEXIA_APP_URL=

# Firebase Admin (servidor)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Firebase Web (cliente, servido em /api/firebase-config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Master por e-mail: opcional, sem valor padrão; só vale com e-mail verificado
MASTER_EMAIL=

# Provedores de IA
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Segredos de endpoints internos (mínimo 32 caracteres aleatórios)
METRICS_SECRET=
DUNNING_SECRET=

# Integrações
GITHUB_TOKEN=
GITHUB_REPO=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Feature flags de segurança (Fase 1) — desligadas por padrão
AUTOCOMMIT_ENABLED=false
SENTINEL_HEAL_ENABLED=false
