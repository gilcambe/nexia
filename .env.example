# Viajante Pro na Hostinger — MODELO de configuração.
# Na Hostinger, preencha estes valores em: Sites > (o app Node.js) > Variáveis de ambiente.
# Ou crie um arquivo .env na pasta do app (Gerenciador de Arquivos). NUNCA envie o .env para o GitHub.

# Banco MySQL (hPanel > Bancos de dados > Gerenciamento). O host na Hostinger é "localhost".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u955456572_viajantepro
DB_USER=u955456572_viajantepro
DB_PASS=coloque-a-senha-do-banco-aqui

# E-mail pelo SMTP da Hostinger (hPanel > E-mails > Contas de e-mail).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@viajante.pro
SMTP_PASS=coloque-a-senha-do-email-aqui
SMTP_FROM=contato@viajante.pro

# Caixa que recebe o aviso de cada cotação nova.
LEADS_NOTIFY_EMAIL=cotacao.site@viajante.pro

# Endereço do painel usado no link do e-mail de cotação.
VP_PAINEL_URL=https://viajante.pro

# 1 = manda http:// para https:// (deixe 1 em produção).
FORCE_HTTPS=1
