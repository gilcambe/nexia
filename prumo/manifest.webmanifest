{
  "name": "Kernex Finance",
  "short_name": "Kernex Fin",
  "id": "/prumo/",
  "description": "Sua vida financeira inteira. Uma inteligência.",
  "start_url": "/prumo/",
  "scope": "/prumo/",
  "display": "standalone",
  "background_color": "#070d1c",
  "theme_color": "#14b8a6",
  "share_target": {
    "action": "/prumo/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "titulo", "text": "texto", "files": [{ "name": "arquivos", "accept": ["application/pdf", ".pdf", "image/*"] }] }
  },
  "lang": "pt-BR",
  "icons": [
    { "src": "/prumo/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/prumo/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/prumo/icone.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
