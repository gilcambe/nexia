rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Checks the user's own profile document for a field value
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function userRole() {
      return userProfile().role;
    }

    function userTenantSlug() {
      return userProfile().tenantSlug;
    }

    function isMaster() {
      return isAuthenticated() && userRole() == 'master';
    }

    function isAdmin() {
      return isAuthenticated() && (userRole() == 'admin' || userRole() == 'master');
    }

    // User belongs to this tenant
    function belongsToTenant(tenantSlug) {
      return isAuthenticated() && userTenantSlug() == tenantSlug;
    }

    // SEC Fase 1 (C2): campos que definem privilégio ou pertença. Só o servidor
    // (Admin SDK) ou um master pode alterá-los.
    function protectedUserKeys() {
      return ['role', 'tenantSlug', 'tenant', 'plan', 'email', 'uid',
              'permissions', 'isAdmin', 'isMaster', 'customClaims', 'claims'];
    }

    // Perfil novo criado pelo próprio usuário: sempre 'user', sem tenant (ou 'guest')
    function isSafeNewProfile(data) {
      return (!('role' in data) || data.role == 'user')
        && (!('tenantSlug' in data) || data.tenantSlug == null || data.tenantSlug == 'guest')
        && (!('plan' in data) || data.plan == 'free')
        && !data.keys().hasAny(['tenant', 'permissions', 'isAdmin', 'isMaster', 'customClaims', 'claims'])
        && (!('uid' in data) || data.uid == uid());
    }

    // Campos do tenant ligados a cobrança/estado: só master altera
    function protectedTenantKeys() {
      return ['plan', 'planLimits', 'billing', 'subscription', 'status', 'ownerUid', 'slug'];
    }

    // Subcoleções de tenant que têm regra explícita abaixo
    function explicitTenantSubcollections() {
      return ['members', 'strike_campaigns', 'strike_pool', 'pool_notifications', 'notifications',
              'striker_prospects', 'cortex_memory', 'kpi', 'billing', 'usage', 'audit_log',
              'rag_docs', 'sentinel', 'modules', 'config', 'osint_log'];
    }

    // User is admin/master of this tenant
    function isAdminOfTenant(tenantSlug) {
      return isAuthenticated() && (isMaster() || (userRole() == 'admin' && userTenantSlug() == tenantSlug));
    }

    // ── /users/{userId} ──────────────────────────────────────────
    // Users can read/write only their own profile; master can read all
    match /users/{userId} {
      allow read:   if isAuthenticated() && (uid() == userId || isMaster());
      allow create: if isAuthenticated() && uid() == userId && isSafeNewProfile(request.resource.data);
      allow update: if isMaster()
                    || (isAuthenticated() && uid() == userId
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserKeys()));
      allow delete: if isMaster();
    }

    // ── /tenants/{tenantSlug} ────────────────────────────────────
    // Tenant doc itself: admins of that tenant + master can read/write
    match /tenants/{tenantSlug} {
      allow read:   if isAuthenticated() && (belongsToTenant(tenantSlug) || isMaster());
      allow create, delete: if isMaster();
      allow update: if isMaster()
                    || (isAdminOfTenant(tenantSlug)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedTenantKeys()));

      // ── /tenants/{tenantSlug}/members ────────────────────────
      match /members/{memberId} {
        allow read:   if isAuthenticated() && (belongsToTenant(tenantSlug) || isMaster());
        allow write:  if isAdminOfTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/strike_campaigns ───────────────
      match /strike_campaigns/{docId} {
        allow read:   if isAuthenticated() && belongsToTenant(tenantSlug);
        allow write:  if isAuthenticated() && belongsToTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/strike_pool ────────────────────
      match /strike_pool/{docId} {
        allow read:   if isAuthenticated() && belongsToTenant(tenantSlug);
        allow write:  if isAuthenticated() && belongsToTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/pool_notifications ─────────────
      match /pool_notifications/{docId} {
        allow read:   if isAuthenticated() && belongsToTenant(tenantSlug);
        allow create: if isAuthenticated() && belongsToTenant(tenantSlug);
        allow update, delete: if isAdminOfTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/notifications ──────────────────
      match /notifications/{docId} {
        allow read:   if isAuthenticated() && belongsToTenant(tenantSlug);
        allow create: if isAuthenticated() && belongsToTenant(tenantSlug);
        allow update, delete: if isAdminOfTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/striker_prospects ──────────────
      match /striker_prospects/{docId} {
        allow read:   if isAuthenticated() && belongsToTenant(tenantSlug);
        allow write:  if isAuthenticated() && belongsToTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/cortex_memory ──────────────────
      // SEC Fase 1 (M2): cada usuário só acessa a própria memória (docId = "<uid>_<conversa>")
      match /cortex_memory/{docId} {
        allow read, write: if isMaster()
                           || (isAuthenticated() && belongsToTenant(tenantSlug) && docId.matches(uid() + '_.*'));
      }

      // ── /tenants/{tenantSlug}/kpi ─────────────────────────────
      match /kpi/{docId} {
        allow read:   if isAuthenticated() && belongsToTenant(tenantSlug);
        allow write:  if isAdminOfTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/billing ─────────────────────────
      match /billing/{docId} {
        allow read:   if isAdminOfTenant(tenantSlug);
        allow write:  if isMaster();
      }

      // ── /tenants/{tenantSlug}/usage ───────────────────────────
      match /usage/{docId} {
        allow read:   if isAdminOfTenant(tenantSlug);
        allow write:  if isAuthenticated() && belongsToTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/audit_log ──────────────────────
      match /audit_log/{docId} {
        allow read:   if isAdminOfTenant(tenantSlug);
        allow create: if isAuthenticated() && belongsToTenant(tenantSlug);
        allow update, delete: if false; // audit logs are immutable
      }

      // ── /tenants/{tenantSlug}/rag_docs ───────────────────────
      match /rag_docs/{docId} {
        allow read:   if isAuthenticated() && belongsToTenant(tenantSlug);
        allow write:  if isAdminOfTenant(tenantSlug);
      }

      // ── /tenants/{tenantSlug}/sentinel ───────────────────────
      match /sentinel/{docId} {
        allow read:   if isAdminOfTenant(tenantSlug);
        allow write:  if isMaster();
      }

      // ── catch-all for any other tenant subcollection ──────────
      // SEC Fase 1: o catch-all não pode afrouxar as subcoleções com regra própria
      // (regras do Firestore somam permissões de todos os matches).
      match /{subcollection}/{docId} {
        allow read:   if !(subcollection in explicitTenantSubcollections())
                      && isAuthenticated() && (belongsToTenant(tenantSlug) || isMaster());
        allow write:  if !(subcollection in explicitTenantSubcollections())
                      && isAdminOfTenant(tenantSlug);
      }
    }

    // ── /nexia_config/{docId} (global platform config) ──────────
    match /nexia_config/{docId} {
      allow read:   if isAuthenticated();
      allow write:  if isMaster();
    }

    // ── /system/{docId} (internal health/overrides) ─────────────
    match /system/{docId} {
      allow read:   if isMaster();
      allow write:  if isMaster();
    }

    // ── /system_status/{docId} (Sentinel scan results) ──────────
    // Leitura: admins autenticados. Escrita: apenas server-side (service account bypassa rules)
    match /system_status/{docId} {
      allow read:   if isAdmin();
      allow write:  if false; // escrito pelo backend via Admin SDK (service account)
    }

    // ── /sentinel_reports/{docId} ────────────────────────────────
    match /sentinel_reports/{docId} {
      allow read:   if isAdmin();
      allow write:  if false; // escrito pelo backend
    }

    // ── /sentinel_heals/{docId} ──────────────────────────────────
    match /sentinel_heals/{docId} {
      allow read:   if isAdmin();
      allow write:  if false; // escrito pelo backend
    }

    // ── /tenants/{tenantSlug}/modules (módulos ativos) ───────────
    // Sub-regra explícita para evitar cair no catch-all e dar permissions error
    match /tenants/{tenantSlug}/modules/{moduleId} {
      allow read:   if isAuthenticated() && (belongsToTenant(tenantSlug) || isMaster());
      allow write:  if isAdminOfTenant(tenantSlug);
    }

    // ── /tenants/{tenantSlug}/config (brand/theme) ────────────────
    match /tenants/{tenantSlug}/config/{configId} {
      allow read:   if isAuthenticated() && (belongsToTenant(tenantSlug) || isMaster());
      allow write:  if isAdminOfTenant(tenantSlug);
    }

    // ── /tenants/{tenantSlug}/osint_log ──────────────────────────
    match /tenants/{tenantSlug}/osint_log/{docId} {
      allow read:   if isAdminOfTenant(tenantSlug);
      allow create: if isAuthenticated() && belongsToTenant(tenantSlug);
      allow update, delete: if false;
    }

    // ── NEXIA AI Vault: /vault_* (Fase 2) ───────────────────────
    // Escrita: somente o servidor (Admin SDK ignora estas regras). Nenhum cliente grava.
    // Leitura: master (custom claim ou perfil) em qualquer tenant; admin do tenant
    // apenas nos documentos do próprio tenant. Usuário comum não lê nada do Vault.
    // vault_idempotency e vault_unique são internos: ninguém lê pelo cliente.
    function isVaultMaster() {
      return isAuthenticated() && (request.auth.token.role == 'master' || userRole() == 'master');
    }

    function canReadVault(tenantId) {
      return isVaultMaster()
        || (isAuthenticated() && userRole() == 'admin' && userTenantSlug() == tenantId);
    }

    match /{vaultCollection}/{vaultDocId} {
      allow read: if vaultCollection.matches('^vault_.+')
                  && !(vaultCollection in ['vault_idempotency', 'vault_unique'])
                  && canReadVault(resource.data.tenant_id);
      allow write: if false;
    }

    // ── NEXIA Body Coach: /bodycoach_users/{uid}/** (ADR-CLONE-02) ──
    // Cada atleta lê e grava só os próprios dados. Coleções fixas; documentos com
    // tamanho limitado (fotos e PDFs pequenos vão como data URL dentro do documento,
    // porque o Cloud Storage do Firebase exige plano pago).
    function bodyCoachOwner(userId) {
      return isAuthenticated() && uid() == userId;
    }

    function bodyCoachOptString(field, max) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function bodyCoachOptNumber(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || request.resource.data[field] is number;
    }

    function bodyCoachValid(coll) {
      let d = request.resource.data;
      return (!('user_id' in d) || d.user_id == uid())
        && (
          (coll == 'profile' && bodyCoachOptString('full_name', 200) && bodyCoachOptString('email', 320)
            && bodyCoachOptNumber('height_cm') && bodyCoachOptNumber('goal_weight_kg') && bodyCoachOptNumber('goal_body_fat_pct')
            && bodyCoachOptString('coach_notes', 5000))
          || (coll == 'meals' && d.name is string && d.name.size() > 0 && d.name.size() <= 200
            && d.calories is number && d.protein is number && d.carbs is number && d.fat is number
            && bodyCoachOptNumber('fiber') && bodyCoachOptString('meal_time', 20))
          || (coll == 'daily_readiness' && d.check_in_date is string && d.check_in_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && bodyCoachOptNumber('readiness_score') && bodyCoachOptString('notes', 2000))
          || (coll == 'progress_entries' && d.taken_at is string && bodyCoachOptNumber('weight_kg') && bodyCoachOptNumber('body_fat_pct')
            && bodyCoachOptString('image_url', 900000) && bodyCoachOptString('notes', 2000))
          || (coll == 'medical_exams' && d.title is string && d.title.size() > 0 && d.title.size() <= 300 && d.taken_at is string
            && bodyCoachOptString('exam_type', 100) && bodyCoachOptString('file_url', 900000) && bodyCoachOptString('notes', 2000))
        );
    }

    match /bodycoach_users/{userId}/{coll}/{docId} {
      allow read, delete: if bodyCoachOwner(userId)
        && coll in ['profile', 'meals', 'daily_readiness', 'progress_entries', 'medical_exams'];
      allow create, update: if bodyCoachOwner(userId)
        && coll in ['profile', 'meals', 'daily_readiness', 'progress_entries', 'medical_exams']
        && bodyCoachValid(coll);
    }

    // ── Default: deny everything else ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
